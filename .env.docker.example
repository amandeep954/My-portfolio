# ========================================================
# AWS EC2 Docker Deployment Environment Configuration
# Copy this file to .env on your AWS EC2 instance:
# cp .env.docker.example .env
# ========================================================

# Database (AWS RDS MySQL)
DB_HOST=portfolio-mysql-db.cbecq6yc2vnu.ap-south-1.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD="your_db_password"
DB_NAME=portfolio_db
DB_PORT=3306

# Admin Auth & Security
JWT_SECRET=your_jwt_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD="your_admin_password"

# AWS S3 Storage Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=amandeep-portfolio-assets

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Frontend API URL
VITE_BACKEND_URL=http://localhost:5000/api

