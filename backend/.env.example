PORT=5000

# AWS RDS MySQL Database Configuration (Active)
DB_HOST=portfolio-mysql-db.cbecq6yc2vnu.ap-south-1.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=your_aws_rds_password
DB_NAME=portfolio_db
DB_PORT=3306

# Local MySQL Database Configuration (Backup / Testing)
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=portfolio_db
# DB_PORT=3306
JWT_SECRET=portfolio_secret_key_super_secure_123!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# AWS S3 Configuration (@aws-sdk/client-s3 v3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-s3-bucket-name
